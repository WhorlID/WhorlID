{
  "name": "@whorlid/whorlid",
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source browser fingerprinting. Works offline with no backend, or connects to the WhorlID API for server-side device matching.",
  "license": "MIT",
  "author": "Badr Aldeen",
  "homepage": "https://github.com/WhorlID/WhorlID",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhorlID/WhorlID.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/WhorlID/WhorlID/issues",
  "keywords": [
    "fingerprint",
    "fingerprinting",
    "browser-fingerprint",
    "device-fingerprint",
    "visitor-id",
    "canvas-fingerprint",
    "bot-detection",
    "fraud-detection",
    "identification"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/whorl.v1.js",
  "jsdelivr": "./dist/whorl.v1.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
